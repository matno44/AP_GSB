{% extends "PgGsbFraisBundle::layout.html.twig" %}
{% block menu %}
<div id="menuGauche">
     <div id="infosUtil">
         <h3>
            {% if app.session.get('nom') %}
                {% if app.session.get('role') == 'administrateur' %}Administrateur
                {%- elseif app.session.get('role') == 'comptable' %}Comptable
                {%- else %}Visiteur{% endif %} :
                bonjour {{ app.session.get('prenom') }} {{ app.session.get('nom') }}
            {% endif %}
        </h3>
     </div>
        {# Le menu dépend du rôle posé en session à la connexion. Masquer un
           lien ne protège rien : chaque contrôleur refait le contrôle côté
           serveur. Le menu ne fait qu'éviter de proposer l'inutile. #}
        <ul id="menuList">
        {% if app.session.get('role') == 'administrateur' %}
	   <li class="smenu">
              <a href="{{path('pg_gsb_frais_admin')}}" title="Gérer les comptes de l'application">Gérer les comptes</a>
           </li>
           <li class="smenu">
              <a href="{{path('pg_gsb_frais_adminjournal')}}" title="Historique des actions d'administration">Journal d'administration</a>
           </li>
        {% elseif app.session.get('role') == 'comptable' %}
	   <li class="smenu">
              <a href="{{path('pg_gsb_frais_validation')}}" title="Valider les fiches de frais">Valider les fiches de frais</a>
           </li>
           <li class="smenu">
              <a href="{{path('pg_gsb_frais_fichespdfmois')}}" title="Archive ZIP des fiches clôturées du mois précédent">Imprimer les fiches du mois</a>
           </li>
        {% else %}
	   <li class="smenu">
              <a href="{{path('pg_gsb_frais_saisirfrais')}}" title="Saisie fiche de frais ">Saisie fiche de frais</a>
           </li>
           <li class="smenu">
              <a href="{{path('pg_gsb_frais_listefrais')}}" title="Consultation de mes fiches de frais">Mes fiches de frais</a>
           </li>
           <li class="smenu">
              <a href="{{path('pg_gsb_frais_monvehicule')}}" title="Déclarer mon véhicule">Mon véhicule</a>
           </li>
        {% endif %}
           <li class="smenu">
              <a href="{{path('pg_gsb_frais_deconnexion')}}" title="Se déconnecter">Déconnexion</a>
           </li>
         </ul>
     </div>
{% endblock%}

{# Contenu par défaut de la page d'accueil. Les vues qui héritent de ce
   template (listemois, saisirtouslesfrais…) redéfinissent le bloc body. #}
{% block body %}
    {% block bloc1 %}
        <div id="contenu">
            {# Message de confirmation déposé par MotDePasseController après un
               changement réussi : il doit être vu, l'utilisateur venant d'être
               redirigé depuis un autre écran. #}
            {% for unMessage in app.session.flashbag.get('confirmation') %}
                <div class="confirmation">{{ unMessage }}</div>
            {% endfor %}
            <h2>Bienvenue sur l'intranet GSB</h2>
            {% if app.session.get('role') == 'administrateur' %}
                <p>
                    Utilisez le menu pour créer, modifier, désactiver ou réactiver
                    les comptes des visiteurs médicaux, des comptables et des
                    administrateurs.
                </p>
            {% elseif app.session.get('role') == 'comptable' %}
                <p>
                    Utilisez le menu pour valider les fiches de frais des visiteurs
                    ou pour imprimer celles du mois.
                </p>
            {% else %}
                <p>
                    Utilisez le menu pour saisir votre fiche de frais du mois en cours
                    ou pour consulter vos fiches précédentes.
                </p>
            {% endif %}
        </div>
    {% endblock %}
{% endblock %}
