<div id="contenu">
<table class="listeLegere">
  	   <caption>Descriptif des éléments hors forfait
       &ndash; {{ nbjustificatifs }} justificatif(s) pris en compte dans le remboursement &ndash;
       </caption>
             <tr>
                <th class="date">Date</th>
				<th class="libelle">Libellé</th>  
                <th class="montant">Montant</th>  
                <th class="justificatif">Justificatif</th>
                <th class="action">&nbsp;</th>              
             </tr>
 	{% for unfrais in  lesfraishorsforfait %}
             {% set libelle = unfrais.libelle %}
             {% set date = unfrais.date %}
             {% set montant = unfrais.montant %}
             {% set idfrais = unfrais.id %}
             <tr>
                <td>{{date}}</td>
                <td>{{libelle}}</td>
                <td>{{montant}}</td>
                {# Un justificatif par ligne : soit on le consulte et on peut le
                   remplacer, soit on en dépose un. Le formulaire vise la ligne
                   par son identifiant, et le contrôleur vérifie côté serveur
                   qu'elle appartient bien au visiteur connecté. #}
                <td>
                    {% if unfrais.nomFichier %}
                        <a href="{{path('pg_gsb_frais_consulterjustificatif',{'id' : idfrais})}}" target="_blank">{{ unfrais.nomOriginal }}</a>
                    {% else %}
                        <em>aucun</em>
                    {% endif %}
                    <form class="formJustificatif" method="post" enctype="multipart/form-data"
                          action="{{path('pg_gsb_frais_joindrejustificatif',{'id' : idfrais})}}">
                        <input type="hidden" name="_token" value="{{ csrf_token('justificatif') }}" />
                        <input type="file" name="justificatif" accept=".pdf,.jpg,.jpeg,.png" required />
                        <input type="submit" value="{% if unfrais.nomFichier %}Remplacer{% else %}Envoyer{% endif %}" />
                    </form>
                </td>
                {# Un formulaire POST, et non plus un lien : une suppression ne
                   doit jamais être déclenchable par un simple chargement
                   d'adresse — une balise <img> suffirait. Le jeton complète
                   la protection. #}
                <td>
                    <form method="post" action="{{path('pg_gsb_frais_supprimerfraishorsforfait',{'id' : idfrais})}}"
                          onsubmit="return confirm('Voulez-vous vraiment supprimer ce frais ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('suppression_frais') }}" />
                        <input type="submit" class="boutonRefus" value="Supprimer ce frais" />
                    </form>
                </td>
             </tr>
	{%endfor%}  
                                          
    </table>
      {# enctype indispensable : sans lui le navigateur n'envoie que le NOM du
         fichier, pas son contenu, et $request->files reste vide. #}
      <form action="{{path('pg_gsb_frais_validerfraishorsforfais')}}" method="post" enctype="multipart/form-data">
      <input type="hidden" name="_token" value="{{ csrf_token('frais_hors_forfait') }}" />
      <div class="corpsForm">
         
          <fieldset>
            <legend>Nouvel élément hors forfait
            </legend>
            <p>
              <label for="txtDateHF">Date (jj/mm/aaaa): </label>
              <input type="text" id="txtDateHF" name="dateFrais" size="10" maxlength="10" value=""  />
            </p>
            <p>
              <label for="txtLibelleHF">Libellé</label>
              <input type="text" id="txtLibelleHF" name="libelle" size="70" maxlength="256" value="" />
            </p>
            <p>
              <label for="txtMontantHF">Montant : </label>
              <input type="text" id="txtMontantHF" name="montant" size="10" maxlength="10" value="" />
            </p>
            <p>
              <label for="fileJustificatif">Justificatif (facultatif) : </label>
              <input type="file" id="fileJustificatif" name="justificatif" accept=".pdf,.jpg,.jpeg,.png" />
            </p>
            <p class="legendeTableau">
              Formats acceptés : {{ extensions }}. Taille maximale : {{ taillemax }} Mo.
              Un frais hors forfait n'est remboursé que sur présentation de la facture ;
              vous pouvez la joindre plus tard, jusqu'à la clôture du mois.
            </p>
          </fieldset>
      </div>
      <div class="piedForm">
      <p>
        <input id="ajouter" type="submit" value="Ajouter" size="20" />
        <input id="effacer" type="reset" value="Effacer" size="20" />
      </p> 
      </div>
        
      </form>
</div>